[Unit]
Description=Selah — notas de prédicas
After=network.target

[Service]
Type=simple
User=selah
Group=selah
WorkingDirectory=/opt/selah/current
EnvironmentFile=/etc/selah/selah.env
Environment=NODE_ENV=production
Environment=SELAH_DATA_DIR=/var/lib/selah
ExecStart=/usr/bin/env node src/server.js
Restart=on-failure
RestartSec=3
# Aislamiento: solo puede escribir en su carpeta de datos.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/selah
MemoryMax=1G
# Servidor compartido: Selah (y ffmpeg) ceden la CPU a los demás proyectos.
Nice=10
CPUQuota=120%

[Install]
WantedBy=multi-user.target
